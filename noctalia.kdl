layout {

    focus-ring {
        active-color   "#d6cffe"
        inactive-color "#141316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d6cffe"
        inactive-color "#141316"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#d6cffe"
        inactive-color "#bab4e1"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d6cffe80"
    }
}

recent-windows {
    highlight {
        active-color "#d6cffe"
        urgent-color "#ffb4ab"
    }
}
