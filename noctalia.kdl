layout {

    focus-ring {
        active-color   "#c8c4d7"
        inactive-color "#141314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c8c4d7"
        inactive-color "#141314"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#c8c4d7"
        inactive-color "#6c6a7b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c8c4d780"
    }
}

recent-windows {
    highlight {
        active-color "#c8c4d7"
        urgent-color "#ffb4ab"
    }
}
